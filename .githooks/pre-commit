#!/usr/bin/env bash
# Pre-commit hook: Block exposed secrets and credentials from being committed
# KAnggara Dotfile Security Guard

set -euo pipefail

# Periksa hanya file yang di-stage untuk commit
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM || true)

if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

# 1. Tolak staging file yang masuk kategori file sensitif
BLOCKED_PATTERNS=(
  "id_rsa"
  "id_ed25519"
  "id_ecdsa"
  "id_dsa"
  "\.pem$"
  "\.key$"
  "\.pfx$"
  "\.p12$"
  "\.env$"
  "\.env\."
  "\.zshrc\.secret$"
  "\.zshrc\.local$"
)

FOUND_SENSITIVE=0

for file in $STAGED_FILES; do
  # Abaikan file template / example
  if [[ "$file" =~ \.example$ ]]; then
    continue
  fi

  for pattern in "${BLOCKED_PATTERNS[@]}"; do
    if echo "$file" | grep -Eq "$pattern"; then
      echo -e "\033[1;31m[SECURITY ALERT]\033[0m File sensitif terdeteksi di-stage:"
      echo -e "  -> \033[1;33m$file\033[0m cocok dengan pola terlarang: \033[0;36m$pattern\033[0m"
      FOUND_SENSITIVE=1
    fi
  done
done

# 2. Scan konten staged changes untuk mendeteksi token, API key, dan private key
python3 - << 'PYEOF'
import sys, subprocess, re

PATTERNS = [
    ("Private Key Header", re.compile(r'-----BEGIN (?:[A-Z0-9_-]+ )?PRIVATE KEY-----')),
    ("GitHub Token", re.compile(r'(?:ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{82}')),
    ("GitLab Token", re.compile(r'glpat-[A-Za-z0-9_\-]{20,}')),
    ("Slack Token", re.compile(r'xox[baprs]-[0-9]{10,13}-[0-9]{10,13}[a-zA-Z0-9-]*')),
    ("AWS Access Key ID", re.compile(r'\bAKIA[0-9A-Z]{16}\b')),
    ("AWS Secret Key Assignment", re.compile(r'(?i)aws_secret_access_key\s*=\s*[A-Za-z0-9/+=]{40}')),
    ("Google API Key", re.compile(r'AIza[0-9A-Za-z-_]{35}')),
    ("OpenAI / AI Key", re.compile(r'\bsk-[A-Za-z0-9]{20,60}\b')),
    ("Generic High-Entropy Secret", re.compile(r'(?i)(?:password|secret|api[_-]?key|access[_-]?token)\s*[:=]\s*[\'\"][A-Za-z0-9_\-\.\/\+]{12,}[\'\"]'))
]

diff_proc = subprocess.Popen(['git', 'diff', '--cached', '-U0', '--', ':!*.example'], stdout=subprocess.PIPE, text=True, errors='ignore')

violations = []
current_file = ""

for line in diff_proc.stdout:
    if line.startswith('+++ b/'):
        current_file = line[6:].strip()
    elif line.startswith('+') and not line.startswith('+++'):
        content = line[1:].strip()
        # Filter obvious placeholders
        if any(dummy in content.lower() for dummy in ['example', 'xxx', 'your_', 'placeholder', 'dummy', 'change_me']):
            continue
        for name, pat in PATTERNS:
            m = pat.search(content)
            if m:
                violations.append((current_file, name, content[:80]))

diff_proc.wait()

if violations:
    print("\033[1;31m[SECURITY ALERT]\033[0m Kredensial rahasia terdeteksi dalam staged changes:")
    for f, name, snippet in violations:
        print(f"  \033[1;33m{f}\033[0m: [{name}] \033[0;36m{snippet}\033[0m")
    print("\n\033[1;31mCommit dibatalkan!\033[0m Silakan bersihkan kredensial atau gunakan file secret lokal terisolasi (.zshrc.secret).")
    sys.exit(1)

PYEOF

if [ $? -ne 0 ] || [ "$FOUND_SENSITIVE" -eq 1 ]; then
  exit 1
fi

exit 0
