# ----------------------------------------------------------------------------
# Local & Sensitive Environment Variables Template
# Copy this file to ~/.zshrc.secret (or .zshrc.secret in this repo)
# DO NOT commit real secrets/tokens to git.
# ----------------------------------------------------------------------------

# Example Tokens & Private Configurations
# export PULL_INTERVAL=3600
# export REPO_URL="https://github.com/your-repo"
# export APP_AUTH_SECRET="your-secret-here"
# export CODECOV_TOKEN="your-codecov-token-here"
# export GIT_AUTH_TOKEN="your-github-personal-access-token"
